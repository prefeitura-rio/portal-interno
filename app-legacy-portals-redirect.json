  "servers": [
    {
      "url": "https://services.pref.rio/legacy-portals-redirect",
      "description": "Production"
    },
    {
      "url": "https://services.staging.app.dados.rio/legacy-portals-redirect",
      "description": "Staging"
    }
  ],
  "components": {
    "requestBodies": {
      "models.RuleInput": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/models.RuleInput"
            }
          }
        },
        "description": "Regra",
        "required": true
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "hosts.Entry": {
        "type": "object",
        "properties": {
          "alias_of": {
            "type": "string",
            "example": "www.1746.rio"
          },
          "hostname": {
            "type": "string",
            "example": "1746.rio"
          },
          "kind": {
            "enum": [
              "canonical",
              "alias"
            ],
            "allOf": [
              {
                "$ref": "#/components/schemas/rules.HostKind"
              }
            ],
            "example": "alias"
          },
          "portal": {
            "type": "string",
            "example": "1746"
          }
        }
      },
      "models.ImportError": {
        "type": "object",
        "properties": {
          "column": {
            "type": "string",
            "example": "destination"
          },
          "line": {
            "type": "integer",
            "example": 3
          },
          "message": {
            "type": "string",
            "example": "o destino deve usar https"
          }
        }
      },
      "models.ImportResult": {
        "type": "object",
        "properties": {
          "created": {
            "type": "integer",
            "example": 4
          },
          "dry_run": {
            "type": "boolean",
            "example": true
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/models.ImportError"
            }
          },
          "total": {
            "type": "integer",
            "example": 6
          },
          "unchanged": {
            "type": "integer",
            "example": 1
          },
          "updated": {
            "type": "integer",
            "example": 1
          }
        }
      },
      "models.RedirectRule": {
        "type": "object",
        "properties": {
          "created_at": {
            "type": "string"
          },
          "created_by": {
            "type": "string",
            "example": "00000000000"
          },
          "destination": {
            "type": "string",
            "example": "https://pref.rio/ouvidoria"
          },
          "enabled": {
            "type": "boolean",
            "example": true
          },
          "host": {
            "type": "string",
            "example": "www.1746.rio"
          },
          "id": {
            "type": "integer",
