      "get": {
        "tags": [
          "Saúde"
        ],
        "summary": "Liveness",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/v1.HealthResponse"
                }
              }
            }
          }
