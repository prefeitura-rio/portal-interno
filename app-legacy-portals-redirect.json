{
  "openapi": "3.0.0",
  "info": {
    "description": "Regras de redirecionamento dos portais legados 1746.rio e carioca.rio para o pref.rio. As rotas /api/v1 exigem o JWT do Keycloak (validado pelo Istio) e papel admin ou superadmin no Heimdall.",
    "title": "Legacy Portals Redirect — API de administração",
    "contact": {
      "name": "IPLANRIO",
      "url": "https://iplan.rio"
    },
    "version": "1.0"
  },
  "paths": {
    "/api/v1/hosts": {
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Hosts canônicos e aliases de hosts.yaml. Regras só podem ser cadastradas num canônico.",
        "tags": [
          "Hosts"
        ],
        "summary": "Lista os hosts",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/v1.HostsResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/response.ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/response.ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/resolve": {
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Diz o que a porta pública faria com a URL numa navegação de navegador (GET com Accept text/html), com as regras ativas: outcome rule, interstitial (página de aviso, 200), fallback ou unknown_host.",
        "tags": [
          "Regras"
        ],
        "summary": "Simula a porta pública",
        "parameters": [
          {
            "description": "URL completa, ex.: https://www.1746.rio/hc/pt-br/p/ouvidoria",
            "name": "url",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/models.ResolveResult"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/response.ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/response.ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/response.ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/rules": {
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Lista paginada, das alteradas mais recentemente. q busca no caminho, no destino e nas notas.",
        "tags": [
          "Regras"
        ],
        "summary": "Lista regras",
        "parameters": [
          {
            "description": "Página (padrão 1)",
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "Itens por página (padrão 20, máx. 200)",
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "Host canônico",
            "name": "host",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Texto no caminho, no destino ou nas notas",
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Só ativas (true) ou só desativadas (false)",
            "name": "enabled",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "description": "301 ou 302",
            "name": "status_code",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/v1.RulesPage"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/response.ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/response.ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/response.ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Normaliza host e caminho antes de validar. Padrões: match_type exact, status_code 302, enabled true. Regra duplicada (mesmo host, caminho e tipo) responde 409 com field path.",
        "tags": [
          "Regras"
        ],
        "summary": "Cria uma regra",
        "requestBody": {
          "$ref": "#/components/requestBodies/models.RuleInput"
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/models.RedirectRule"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/response.ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/response.ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/response.ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/response.ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/rules/export": {
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Mesmo formato da importação, por host e caminho: exportar e reimportar não muda nada.",
        "tags": [
          "Regras"
        ],
        "summary": "Exporta as regras em CSV",
        "responses": {
          "200": {
            "description": "CSV (anexo redirecionamentos-AAAA-MM-DD.csv)",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "text/csv": {
                "schema": {
                  "$ref": "#/components/schemas/response.ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "text/csv": {
                "schema": {
                  "$ref": "#/components/schemas/response.ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/rules/import": {
      "post": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "CSV UTF-8 (BOM aceito) no campo file, até 5 MB e 20.000 linhas. Cabeçalho obrigatório com as colunas host,path,match_type,destination,status_code,enabled,notes em qualquer ordem; vazios viram exact, 302 e true. Atualiza pelo trio host + caminho + tipo. Com dry_run=true só valida (200). Sem dry_run, grava tudo numa transação se não houver erro; com erro, nada é gravado e a resposta é 422 com o relatório. A linha 1 é o cabeçalho.",
        "tags": [
          "Regras"
        ],
        "summary": "Importa regras de um CSV",
        "parameters": [
          {
            "description": "Só valida, sem gravar",
            "name": "dry_run",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "description": "Arquivo CSV",
                    "type": "string",
                    "format": "binary"
                  }
                },
                "required": [
                  "file"
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/models.ImportResult"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/response.ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/response.ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/response.ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Request Entity Too Large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/response.ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/models.ImportResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/rules/status": {
      "patch": {
