    "/readyz": {
      "get": {
        "description": "Pronto quando hosts.yaml e a primeira carga das regras em memória estão feitos. Com o banco fora depois disso, continua pronto (status degraded): a porta pública segue com a última cópia das regras.",
        "tags": [
          "Saúde"
        ],
        "summary": "Readiness",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
